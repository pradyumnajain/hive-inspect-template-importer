# Supabase project settings -> API -> "Project URL".
# The origin only. No trailing slash, and NOT the REST endpoint: the client
# appends /rest/v1 itself, and pasting that path produces a 400 from the API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# "anon" public key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# "service_role" secret key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Used by import/duplicate/seed routes, which bypass row level security.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
